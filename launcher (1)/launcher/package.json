{
  "name": "ghost-launcher",
  "version": "1.0.0",
  "description": "Ghost Launcher - Minecraft 1.21.11 (Fabric)",
  "main": "main.js",
  "author": "iamniketan44-cpu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "msmc": "^5.0.5",
    "minecraft-launcher-core": "^3.18.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ghost.launcher",
    "productName": "Ghost Launcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "GhostLauncherSetup.${ext}"
    }
  }
}
